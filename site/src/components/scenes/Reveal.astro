---
// Reveal: verdeckte Karte, die beim Antippen den Fakt aufdeckt (Svelte-Insel).
import SourceTag from '../SourceTag.astro';
import RevealIsland from './RevealIsland.svelte';
import { hl } from '../../scripts/hl-server.js';

interface Props {
  scene: {
    teaser: string;
    headline: string;
    body: string;
    source?: { label: string; url: string; visited?: string };
  };
}
const { scene } = Astro.props;
---

<div class="reveal-scene">
  <RevealIsland client:visible teaser={scene.teaser} headline={hl(scene.headline)} body={hl(scene.body)} />
  {scene.source && <SourceTag source={scene.source} tooltip={scene.context_tooltip} />}
</div>

<style>
  .reveal-scene {
    max-width: 44rem;
    width: 100%;
  }
</style>