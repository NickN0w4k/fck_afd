---
// Quote: Vollbild-Zitat, Wörter sliden einzeln rein.
// Runde 3 (Nick): Einordnung GROSS und prominent direkt unter dem Zitat —
// Feld `verdict` (harte Kritik, sichtbar) oder Fallback `context`. Das alte
// Mini-Einordnungsfeld (0.92rem) war zu unauffällig unter dem Mega-Zitat.
import SourceTag from '../SourceTag.astro';

interface Props {
  scene: {
    quote: string;
    author: string;
    context?: string;
    verdict?: string;
    source?: { label: string; url: string; visited?: string };
  };
}
const { scene } = Astro.props;
const verdict = scene.verdict ?? scene.context;
---

<blockquote class="quote">
  <p class="quote-text" data-quote data-hl>„{scene.quote}“</p>
  <footer class="quote-footer" data-anim="rise">
    <p class="quote-author">{scene.author}</p>
    {verdict && (
      <div class="quote-verdict">
        <p class="verdict-kicker">Warum das schlecht ist</p>
        <p class="verdict-text" data-hl>{verdict}</p>
      </div>
    )}
  </footer>
  {scene.source && <SourceTag source={scene.source} tooltip={scene.context_tooltip} />}
</blockquote>

<style>
  .quote {
    margin: 0;
    max-width: 56rem;
  }
  .quote-text {
    font-family: var(--font-head);
    font-size: clamp(1.9rem, 6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .quote-text :global(.word) {
    display: inline-block;
  }
  .quote-footer {
    margin-top: 2rem;
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
  }
  .quote-author {
    font-family: var(--font-head);
    font-weight: 600;
  }
  /* Runde 3: Verdict-Block — groß, lesbar, klar als Bewertung markiert */
  .quote-verdict {
    margin-top: 1.4rem;
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 12px;
    padding: 1.2rem 1.4rem;
    background: var(--bg-elev);
    max-width: 52ch;
  }
  .verdict-kicker {
    font-family: var(--font-head);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.55rem;
  }
  .verdict-text {
    font-family: var(--font-head);
    font-size: clamp(1.15rem, 3.2vw, 1.6rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg);
  }
</style>