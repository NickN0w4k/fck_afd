---
// Quote: Vollbild-Zitat, Wörter sliden einzeln rein. Kontext als Einordnung-Karte.
import SourceTag from '../SourceTag.astro';

interface Props {
  scene: {
    quote: string;
    author: string;
    context?: string;
    source?: { label: string; url: string; visited?: string };
  };
}
const { scene } = Astro.props;
---

<blockquote class="quote">
  <p class="quote-text" data-quote data-hl>„{scene.quote}“</p>
  <footer class="quote-footer" data-anim="rise">
    <p class="quote-author">{scene.author}</p>
    {scene.context && (
      <div class="quote-context">
        <p class="context-kicker">Einordnung</p>
        <p class="context-text" data-hl>{scene.context}</p>
      </div>
    )}
  </footer>
  {scene.source && <SourceTag source={scene.source} />}
</blockquote>

<style>
  .quote {
    margin: 0;
    max-width: 56rem;
  }
  .quote-text {
    font-family: var(--font-head);
    font-size: clamp(1.9rem, 6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .quote-text :global(.word) {
    display: inline-block;
  }
  .quote-footer {
    margin-top: 2rem;
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
  }
  .quote-author {
    font-family: var(--font-head);
    font-weight: 600;
  }
  .quote-context {
    margin-top: 0.9rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 12px;
    padding: 0.9rem 1.1rem;
    background: var(--bg-elev);
    max-width: 46ch;
  }
  .context-kicker {
    font-family: var(--font-head);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.4rem;
  }
  .context-text {
    font-size: 0.92rem;
    color: var(--fg-muted);
    line-height: 1.55;
  }
</style>