---
// ChapterBreak: volle Farbfläche, große Nummer mit Parallax, Frage als Cliffhanger.
interface Props {
  chapter: { id: string; num: string; title: string; accent: string; question: string };
  scene?: { summary?: string; next_title?: string };
}
const { chapter, scene } = Astro.props;
---

<div class="chapterbreak" style={`background: ${chapter.accent}; --chbg: ${chapter.accent}; color: var(--accent-contrast);`}>
  <p class="ch-num" data-chapter-num aria-hidden="true">{chapter.num}</p>
  <div class="ch-body">
    <h2 class="ch-title" data-anim="rise">{chapter.title}</h2>
    <p class="ch-question" data-anim="rise">{chapter.question}</p>
    {scene?.summary && <p class="ch-summary" data-anim="rise">{scene.summary}</p>}
  </div>
</div>

<style>
  .chapterbreak {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--scene-pad);
    overflow: hidden;
  }
  .ch-num {
    font-family: var(--font-head);
    font-size: clamp(9rem, 34vw, 26rem);
    font-weight: 700;
    line-height: 0.85;
    opacity: 0.25;
    letter-spacing: -0.04em;
    position: absolute;
    right: var(--scene-pad);
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    user-select: none;
  }
  /* Fix 12.09. (Nick): Die große Kapitelnummer lief mitten durch den Text — schwarze
     Schrift auf dunkler Zahl war unlesbar. Weiche Abschattung hinter dem Text-Block
     in der Kapitelfarbe (CSS-Var --chbg) „drückt die Nummer lokal zurück": radialer
     Verlauf liest sich als sanfter Schatten, keine harte Kante. */
  .ch-body {
    position: relative;
    z-index: 1; /* Text über der Nummer */
  }
  .ch-body::before {
    content: '';
    position: absolute;
    inset: -1.8rem -1.4rem -1.8rem -0.6rem; /* rechts breiter: dort steht die Nummer */
    z-index: -1;
    border-radius: 24px;
    /* Halbtransparente Kapitelfarbe: Nummer bleibt schwach sichtbar (Tiefe), Text kontrastiert */
    background: radial-gradient(
      ellipse at 78% 55%,
      color-mix(in srgb, var(--chbg) 82%, transparent) 40%,
      transparent 85%
    );
    filter: blur(2px);
    pointer-events: none;
  }
  .ch-question {
    font-family: var(--font-head);
    font-size: clamp(1.2rem, 3vw, 2rem);
    font-weight: 500;
    max-width: 24ch;
    margin-top: 1rem;
    opacity: 0.85;
  }
  .ch-summary {
    margin-top: 2.25rem;
    font-size: clamp(1rem, 2.4vw, 1.3rem);
    font-weight: 500;
    max-width: 30ch;
    opacity: 0.95;
  }
</style>