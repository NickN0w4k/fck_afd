---
// Hero: Canvas-Partikel im Hintergrund, Titel slidet rein.
// Welle 3 / 3.3: .hero-glow ist der Ambient-Glow-Layer für den Parallax-Pin
// (initHeroParallax: Glow yPercent 30 scrub, Hero-Level fade-out, end '+=600').
interface Props {
  scene: {
    title: string;
    subtitle: string;
    cta?: string;
  };
}
const { scene } = Astro.props;
---

<Fragment>
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    <h1 class="hero-title" data-anim="rise">{scene.title}</h1>
    <p class="hero-sub" data-anim="rise">{scene.subtitle}</p>
  </div>
  <div class="swipe-hint" aria-hidden="true">
    <span>{scene.cta ?? 'Scrollen'}</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14" /><path d="m19 12-7 7-7-7" />
    </svg>
  </div>
</Fragment>

<style>
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* Ambient-Glow-Layer (Welle 3): liegt über dem Partikel-Canvas, unter dem Inhalt;
     überragt die Szene oben/unten, damit yPercent 30 keine Kanten freilegt */
  .hero-glow {
    position: absolute;
    inset: -30% 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(58% 46% at 14% 40%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%),
      radial-gradient(50% 40% at 86% 60%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 72%);
    filter: blur(28px);
    will-change: transform;
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 60rem;
  }
  .hero-title {
    font-size: clamp(3rem, 12vw, 8.5rem);
  }
  .hero-title :global(.char) {
    display: inline-block;
  }
  /* Mobile: Titel größer skalieren, mehr Präsenz */
  @media (max-width: 640px) {
    .hero-title {
      font-size: clamp(3.4rem, 17vw, 5rem);
    }
    .hero-sub {
      font-size: 1.15rem;
      max-width: 100%;
    }
  }
  .hero-sub {
    margin-top: 1.5rem;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    color: var(--fg-muted);
    max-width: 34ch;
  }
  .swipe-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-head);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-muted);
    animation: bob 2.2s var(--ease-out) infinite;
  }
  /* Mobile: Hint weiter unten, damit er nicht mit dem Titel kollidiert */
  @media (max-width: 640px) {
    .hero-inner {
      padding-bottom: 0;
    }
    .hero-sub {
      margin-top: 1.1rem;
    }
  }
  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .swipe-hint { animation: none; }
  }
</style>

<script>
  // Titel in Buchstaben-Spans für Stagger-Animation
  const title = document.querySelector('.hero-title');
  if (title && !title.dataset.split) {
    title.innerHTML = title.textContent
      .split('')
      .map((c) => (c === ' ' ? ' ' : `<span class="char">${c}</span>`))
      .join('');
    title.dataset.split = '1';
  }

  // Partikel-Canvas: dezente driftende Punkte, die zum Cursor gezogen werden
  const canvas = document.querySelector('.hero-canvas');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d');
    let w, h, raf;
    const N = 70;
    const pts = Array.from({ length: N }, () => ({
      x: Math.random(),
      y: Math.random(),
      vx: (Math.random() - 0.5) * 0.0006,
      vy: (Math.random() - 0.5) * 0.0006,
      r: Math.random() * 1.6 + 0.4,
    }));
    let mx = -999, my = -999;
    window.addEventListener('pointermove', (e) => {
      mx = e.clientX / window.innerWidth;
      my = e.clientY / window.innerHeight;
    }, { passive: true });

    const resize = () => {
      w = canvas.width = canvas.offsetWidth * devicePixelRatio;
      h = canvas.height = canvas.offsetHeight * devicePixelRatio;
    };
    resize();
    window.addEventListener('resize', resize, { passive: true });

    const accent = () => getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#ff4d2e';

    const tick = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = accent();
      for (const p of pts) {
        // sanfte Anziehung zum Pointer
        const dx = mx - p.x, dy = my - p.y;
        const d2 = dx * dx + dy * dy;
        if (d2 < 0.06 && d2 > 0.0001) {
          p.vx += dx * 0.00004;
          p.vy += dy * 0.00004;
        }
        p.vx *= 0.995; p.vy *= 0.995;
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x += 1; if (p.x > 1) p.x -= 1;
        if (p.y < 0) p.y += 1; if (p.y > 1) p.y -= 1;
        ctx.globalAlpha = 0.5;
        ctx.beginPath();
        ctx.arc(p.x * w, p.y * h, p.r * devicePixelRatio, 0, Math.PI * 2);
        ctx.fill();
      }
      raf = requestAnimationFrame(tick);
    };
    // Nur rendern, solange Hero sichtbar (IntersectionObserver spart Strom)
    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        if (!raf) raf = requestAnimationFrame(tick);
      } else {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    });
    io.observe(canvas);
  }
</script>