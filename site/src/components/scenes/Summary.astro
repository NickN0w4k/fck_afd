---
// Summary: TL;DR-Karten (Bestand) + optional facts [{big,label}] als StatTile-Grid (Welle 2, apex §2).
import StatTile from '../StatTile.astro';

interface Props {
  scene: {
    tldr: { num: string; text: string }[];
    closing?: string;
    facts?: { big: string; label: string }[];
  };
  chapters: { id: string; num: string; title: string; accent: string }[];
}
const { scene, chapters } = Astro.props;
const tldrItems = scene.tldr.map((p, i) =>
  typeof p === 'string' ? { num: String(i + 1).padStart(2, '0'), text: p } : p
);
---

<div class="summary">
  <p class="kicker">Das Wichtigste in Kürze</p>
  <div class="tldr">
    {
      tldrItems.map((point, i) => (
        <div class="card" data-anim="rise" style={`--d: ${i * 90}ms`}>
          <span class="card-num">{point.num}</span>
          <p class="card-text">{point.text}</p>
        </div>
      ))
    }
  </div>

  {
    scene.facts && scene.facts.length > 0 && (
      <div class="facts">
        {scene.facts.map((f, i) => (
          <StatTile big={f.big} label={f.label} delay={i * 90} />
        ))}
      </div>
    )
  }

  <p class="closing" data-anim="rise">{scene.closing}</p>
</div>

<style>
  .summary {
    max-width: 48rem;
  }
  .tldr {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .card {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.9rem 1.1rem;
    transition: transform 0.2s var(--ease-out), border-color 0.2s;
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .card-num {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 8px;
    padding: 0.15rem 0.45rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .card-text {
    font-family: var(--font-head);
    font-size: clamp(0.98rem, 2.4vw, 1.25rem);
    font-weight: 600;
    line-height: 1.35;
  }
  .facts {
    margin-top: 1.6rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.7rem;
  }
  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .closing {
    margin-top: 2rem;
    color: var(--fg-muted);
    font-size: 1rem;
  }
</style>