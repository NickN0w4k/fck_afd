---
// Summary: TL;DR fliegt nacheinander ein + Themen-Chips (Chips sind Anker-Links zu Kapitel-Starts).
interface Props {
  scene: {
    tldr: string[];
    closing?: string;
  };
  chapters: { id: string; num: string; title: string; accent: string }[];
}
const { scene, chapters } = Astro.props;
---

<div class="summary">
  <p class="kicker">Das Wichtigste in Kürze</p>
  <ul class="tldr">
    {scene.tldr.map((point) => <li data-anim="rise">{point}</li>)}
  </ul>
  <p class="closing" data-anim="rise">{scene.closing}</p>
</div>

<style>
  .summary {
    max-width: 48rem;
  }
  .tldr {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .tldr li {
    font-family: var(--font-head);
    font-size: clamp(1.15rem, 2.6vw, 1.7rem);
    font-weight: 600;
    line-height: 1.3;
    padding-left: 1.6rem;
    position: relative;
  }
  .tldr li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .closing {
    margin-top: 2.5rem;
    color: var(--fg-muted);
    font-size: 1.05rem;
  }
</style>