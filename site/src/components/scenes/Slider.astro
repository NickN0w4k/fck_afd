---
// Slider: Nutzer schätzt einen Wert, Antwort reveal mit Abweichungs-Feedback.
import SourceTag from '../SourceTag.astro';
import SliderIsland from './SliderIsland.svelte';

interface Props {
  scene: {
    prompt: string;
    min?: number;
    max?: number;
    answer: number;
    unit?: string;
    explanation: string;
    source?: { label: string; url: string; visited?: string };
  };
}
const { scene } = Astro.props;
---

<div class="slider-scene">
  <h2 class="slider-prompt" data-anim="rise">{scene.prompt}</h2>
  <SliderIsland client:visible min={scene.min ?? 0} max={scene.max ?? 100} answer={scene.answer} unit={scene.unit ?? ''} explanation={scene.explanation} />
  {scene.source && <SourceTag source={scene.source} tooltip={scene.context_tooltip} />}
</div>

<style>
  .slider-scene {
    max-width: 44rem;
    width: 100%;
  }
  .slider-prompt {
    font-size: clamp(1.4rem, 3.8vw, 2.4rem);
    margin-bottom: 2rem;
  }
</style>