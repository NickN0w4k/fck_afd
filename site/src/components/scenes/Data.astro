---
// Data: Count-up-Zahl + animiertes Balken- oder Donut-Diagramm.
import SourceTag from '../SourceTag.astro';

interface Props {
  scene: {
    headline: string;
    value?: number;
    suffix?: string;
    caption?: string;
    chart?: 'bars' | 'donut' | 'diverging' | 'tiles' | 'compare';
    count_scrub?: boolean;
    series?: { label: string; value: number }[];
    source?: { label: string; url: string; visited?: string };
  };
}
const { scene } = Astro.props;

// Zahlformatierung de-DE (max. 1 Dezimalstelle, für Serien-Werte)
const fmtNum = (v: number) => v.toLocaleString('de-DE', { maximumFractionDigits: 1 });
// Vorzeichenbehaftet (diverging): −19.190 / +440
const fmtSigned = (v: number) => `${v < 0 ? '−' : '+'}${Math.abs(v).toLocaleString('de-DE', { maximumFractionDigits: 1 })}`;

// Welle 3 / 3.1: die 28.000er-Szene (VSB 2025, Kapitel verfassungsschutz) bekommt
// den Punkt-Schwarm als Pin-Stack (apex §3) — die Balken-Zeitreihe bleibt als Folge-Element.
const isSwarm = scene.value === 28000 && scene.chart === 'bars';
// Schwarm-Phasen: 1 Punkt ≈ 250 Personen → 45 (11.300) → 80 (20.000) → 112 (28.000)
const SWARM_PHASES = [
  { value: 11300, dots: 45, label: '2023' },
  { value: 20000, dots: 80, label: '2024' },
  { value: 28000, dots: 112, label: '2025' },
];
---

<div class="data">
  <h2 class="data-headline" data-anim="rise">{scene.headline}</h2>

  {
    scene.value !== undefined && (
      <p class="data-value">
        {/* count_scrub: Zahl folgt dem Scroll (initCountScrub); sonst einmaliger Count-up (initCount).
            Swarm-Szene: Zähler läuft scrubbed im Pin-Stack mit (initPinStack, data-count-scrub-Muster) */}
        <span
          data-swarm-count={isSwarm ? scene.value : undefined}
          data-count-scrub={!isSwarm && scene.count_scrub ? scene.value : undefined}
          data-count={!isSwarm && !scene.count_scrub ? scene.value : undefined}
        >{isSwarm ? fmtNum(scene.value) : '0'}</span>
        {scene.suffix && <span class="data-suffix">{scene.suffix}</span>}
      </p>
    )
  }

  {
    isSwarm && (
      // Welle 3 / 3.1 — 28.000er-Punktschwarm (apex §3 Pin-Stack): SSR im Endzustand
      // (alle 112 Kreise gefärbt, Jahr 2025) → reduced-motion/no-JS sehen sofort das Ergebnis;
      // initPinStack setzt den Startzustand und poppt die Kreise in 3 Phasen im Pin.
      <div class="swarm" data-swarm data-swarm-phases={JSON.stringify(SWARM_PHASES)}>
        <div class="swarm-years" aria-hidden="true">
          {SWARM_PHASES.map((p, i) => (
            <span class:list={['swarm-year', { 'is-on': i === SWARM_PHASES.length - 1 }]}>{p.label}</span>
          ))}
        </div>
        <div class="swarm-dots" aria-hidden="true">
          {Array.from({ length: SWARM_PHASES[SWARM_PHASES.length - 1].dots }, () => (
            <i class="swarm-dot" data-swarm-dot />
          ))}
        </div>
        <p class="swarm-legend">1 Punkt ≈ 250 Menschen</p>
      </div>
    )
  }

  {
    scene.chart === 'bars' && scene.series && (
      <div class="bars" role="img" aria-label={scene.series.map((s) => `${s.label}: ${s.value}`).join(', ')}>
        {scene.series.map((s) => (
          <div class="bar-row">
            <span class="bar-label">{s.label}</span>
            <div class="bar-track">
              <div class="bar-fill" data-bar style={`--w: ${s.value}%`} />
            </div>
          </div>
        ))}
      </div>
    )
  }

  {
    scene.chart === 'diverging' && scene.series && (() => {
      // Diverging Bars: negative/positive Werte um eine Nulllinie (apex §1: +440 vs −19.190).
      // Skala = max absoluter Wert; SSR-Endzustand: --up/--down sind gesetzt, JS animiert nur die Höhe.
      const max = Math.max(...scene.series.map((s) => Math.abs(s.value)), 1);
      return (
        <div class="bars diverging" role="img" aria-label={scene.series.map((s) => `${s.label}: ${fmtSigned(s.value)}`).join(', ')}>
          {scene.series.map((s) => {
            const up = s.value >= 0;
            // Mindestlänge 4 %: 19.190 vs 440 wäre sonst unsichtbar (2,3 %) — Verhältnis bleibt dominant
            const pct = Math.min(100, Math.max(4, (Math.abs(s.value) / max) * 100));
            return (
              <div class="bar-row diverging-row">
                <span class="bar-label">{s.label}</span>
                <div class="dv-axis">
                  <div class={`dv-fill ${up ? 'is-up' : 'is-down'}`} data-bar style={`--h: ${pct}%`} />
                </div>
                <span class={`dv-val ${up ? 'is-up' : 'is-down'}`}>{fmtSigned(s.value)}</span>
              </div>
            );
          })}
        </div>
      );
    })()
  }

  {
    scene.chart === 'tiles' && scene.value !== undefined && (() => {
      // 10×10-Kachel-Raster: value färbt die ersten N Kacheln (apex §1: 44 % → 44 Kacheln).
      // Rein DOM/CSS + Registry-Stagger (data-tile); SSR-Endzustand: --filled Kacheln sind gefärbt.
      const n = Math.max(0, Math.min(100, Math.round(scene.value)));
      const tiles = Array.from({ length: 100 }, (_, i) => i < n);
      return (
        <div
          class="tiles"
          data-tiles={n}
          role="img"
          aria-label={`${n} von 100${scene.suffix ? ` ${scene.suffix}` : ''}`}
        >
          {tiles.map((on, i) => (
            <div
              class:list={['tile', { 'is-on': on }]}
              data-tile
              style={`--i: ${i}`}
              aria-hidden="true"
            />
          ))}
        </div>
      );
    })()
  }

  {
    scene.chart === 'compare' && scene.value !== undefined && scene.series && (() => {
      // Anker-Vergleich: scene.value = Ankerwert (Akzent), series = Referenz-Balken darunter (muted).
      // Alle Werte als %-Anteil des Maximums → der Anker überragt sichtbar (apex §1: 690 vs. ~500/300).
      const all = [scene.value, ...scene.series.map((s) => s.value)];
      const max = Math.max(...all.map((v) => Math.abs(v)), 1);
      return (
        <div
          class="bars compare"
          role="img"
          aria-label={`${scene.headline}: ${fmtNum(scene.value)}${scene.suffix ?? ''} — ${scene.series.map((s) => `${s.label}: ${fmtNum(s.value)}`).join(', ')}`}
        >
          <div class="bar-row">
            <span class="bar-label">{fmtNum(scene.value)}{scene.suffix}</span>
            <div class="bar-track">
              <div class="bar-fill" data-bar style={`--w: ${(Math.abs(scene.value) / max) * 100}%`} />
            </div>
          </div>
          {scene.series.map((s) => (
            <div class="bar-row">
              <span class="bar-label">{s.label}</span>
              <div class="bar-track">
                <div class="bar-fill is-ref" data-bar style={`--w: ${(Math.abs(s.value) / max) * 100}%`} />
              </div>
            </div>
          ))}
        </div>
      );
    })()
  }

  {
    scene.chart === 'donut' && scene.value !== undefined && (
      <svg class="donut" viewBox="0 0 120 120" role="img" aria-label={`${scene.value}${scene.suffix ?? ''}`}>
        <circle class="donut-track" cx="60" cy="60" r="48" />
        <circle class="donut-fill" cx="60" cy="60" r="48" data-donut={scene.value} />
      </svg>
    )
  }

  {
    scene.caption && !scene.value && (() => {
      // Pull-Number: erste Zahl mit Einheit aus langer Caption herausziehen (nur wenn kein value/Count-up)
      const m = scene.caption.match(/(\d[\d.,]*\s?(?:%|€|Mrd\.?|Mio\.?|Millionen|Milliarden)?)/);
      const pull = m ? m[0].trim() : null;
      return pull && scene.caption.length > 220 && (
        <p class="data-pull" data-anim="rise">{pull}</p>
      );
    })()
  }

  {scene.caption && <p class="data-caption" data-anim="rise">{scene.caption}</p>}
  {scene.source && <SourceTag source={scene.source} tooltip={scene.context_tooltip} />}
</div>

<style>
  .data {
    max-width: 52rem;
    width: 100%;
  }
  .data-headline {
    font-size: clamp(1.5rem, 4vw, 2.6rem);
  }
  .data-value {
    font-family: var(--font-head);
    font-size: clamp(4.5rem, 18vw, 12rem);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    margin: 1.5rem 0;
    font-variant-numeric: tabular-nums;
  }
  .data-suffix {
    font-size: 0.45em;
    color: var(--fg);
  }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }
  .bar-row {
    display: grid;
    grid-template-columns: minmax(6rem, 10rem) 1fr;
    align-items: center;
    gap: 1rem;
  }
  .bar-label {
    font-family: var(--font-head);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }
  .bar-track {
    height: 14px;
    background: rgba(245, 242, 236, 0.08);
    border-radius: 99px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    border-radius: 99px;
    background: var(--accent);
    width: 0%;
  }
  .donut {
    width: min(60vw, 260px);
    margin-top: 1.5rem;
    transform: rotate(-90deg);
  }
  .donut-track {
    fill: none;
    stroke: rgba(245, 242, 236, 0.08);
    stroke-width: 12;
  }
  .donut-fill {
    fill: none;
    stroke: var(--accent);
    stroke-width: 12;
    stroke-linecap: round;
  }
  .data-caption {
    margin-top: 1.25rem;
    color: var(--fg-muted);
    max-width: 46ch;
    line-height: 1.6;
  }
  .data-pull {
    margin-top: 0.6rem;
    font-family: var(--font-head);
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  /* ===== Welle 3: 28.000er-Punktschwarm (Pin-Stack, apex §3) ===== */
  .swarm {
    margin-top: 1.25rem;
  }
  .swarm-years {
    position: relative;
    height: 1.25em;
    margin-bottom: 0.9rem;
    font-family: var(--font-head);
  }
  .swarm-year {
    position: absolute;
    left: 0;
    top: 0;
    font-size: clamp(1.3rem, 4.5vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
    opacity: 0; /* JS blendet die Phasen-Jahre um (SSR: 2025 sichtbar via .is-on) */
  }
  .swarm-year.is-on {
    opacity: 1;
  }
  .swarm-dots {
    display: grid;
    grid-template-columns: repeat(14, 1fr); /* 112 Punkte = 8 × 14 */
    gap: 4px;
    max-width: 26rem;
  }
  .swarm-dot {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent); /* SSR-Endzustand: alle 112 gefärbt */
  }
  .swarm-legend {
    margin-top: 0.8rem;
    font-size: 0.78rem;
    color: var(--fg-muted);
  }

  /* ===== Diverging Bars: negativ rot nach unten, positiv Akzent nach oben, Nulllinie sichtbar ===== */
  .diverging {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: 1.5rem;
  }
  .dv-axis {
    position: relative;
    height: 74px;
    flex: 1;
  }
  /* Nulllinie: harte Kante zwischen Auf-/Ab-Zone */
  .dv-axis::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: rgba(245, 242, 236, 0.25);
  }
  .dv-fill {
    position: absolute;
    left: 0;
    right: 0;
    border-radius: 3px;
  }
  /* Über der Nulllinie: wächst von der Linie nach oben (bottom: 50%) */
  .dv-fill.is-up {
    bottom: 50%;
    width: var(--h, 0%); /* initBars animiert width — hier = Länge des Balkens */
    max-width: 100%;
    height: 8px;
    background: var(--accent);
  }
  /* Unter der Nulllinie: wächst von der Linie nach unten (top: 50%), rot */
  .dv-fill.is-down {
    top: 50%;
    width: var(--h, 0%);
    max-width: 100%;
    height: 8px;
    background: var(--data-danger, #e5484d);
  }
  .dv-val {
    font-family: var(--font-head);
    font-size: 0.85rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    min-width: 4.6em;
    text-align: right;
  }
  .dv-val.is-up {
    color: var(--accent);
  }
  .dv-val.is-down {
    color: var(--data-danger, #e5484d);
  }

  /* ===== 10×10-Kachel-Raster (tiles): value färbt erste N, Rest dunkel ===== */
  .tiles {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 4px;
    margin-top: 1.5rem;
    max-width: 22rem;
  }
  .tile {
    aspect-ratio: 1;
    border-radius: 3px;
    background: rgba(245, 242, 236, 0.08);
  }
  .tile.is-on {
    background: var(--accent);
  }

  /* ===== compare: Anker Akzent, Referenzen muted ===== */
  .compare .bar-fill.is-ref {
    background: rgba(245, 242, 236, 0.35);
  }
</style>