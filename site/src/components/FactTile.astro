---
// FactTile: quadratische Fakten-Kachel (apex §2) — Icon (Inline-SVG-Prop, optional)
// + Zahl/2-Wörter-Label + optionale Quelle. Entrance: Stagger-Rise über Registry.
interface Props {
  icon?: string; // Inline-SVG-Markup (Lucide-Subset, stroke 2px, 24er-Grid, currentColor)
  value: string; // Zahl oder 2-Wörter-Kern („28.000“, „Verfassungsfeindlich“)
  label?: string; // 1 kurze Ergänzung
  source?: { label: string; url: string; visited?: string };
  delay?: number; // ms, für Stagger-Rise (--d)
}
const { icon, value, label, source, delay = 0 } = Astro.props;
---

<div class="fact-tile" data-anim="rise" style={`--d: ${delay}ms`}>
  {icon && <span class="ft-icon" aria-hidden="true" set:html={icon} />}
  <span class="ft-value">{value}</span>
  {label && <span class="ft-label">{label}</span>}
  {source && (
    <a class="ft-source" href={source.url} target="_blank" rel="noopener noreferrer">
      {source.label}
    </a>
  )}
</div>

<style>
  .fact-tile {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    gap: 0.3rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.9rem;
    min-height: 0;
    overflow: hidden;
  }
  .ft-icon {
    display: inline-flex;
    color: var(--accent);
    margin-bottom: auto;
  }
  .ft-icon :global(svg) {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ft-value {
    font-family: var(--font-head);
    font-size: clamp(1.15rem, 3.2vw, 1.6rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .ft-label {
    font-size: 0.8rem;
    line-height: 1.3;
    color: var(--fg-muted);
  }
  .ft-source {
    font-size: 0.68rem;
    color: var(--fg-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    margin-top: 0.15rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ft-source:hover {
    color: var(--fg);
  }
</style>