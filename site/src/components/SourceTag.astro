---
// Quelle als klickbarer Beleg-Tag.
interface Props {
  source: { label: string; url: string; visited?: string };
}
const { source } = Astro.props;
---

<a class="source-tag" href={source.url} target="_blank" rel="noopener noreferrer">
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
    <path d="M15 3h6v6" />
    <path d="M10 14 21 3" />
  </svg>
  <span>{source.label}{source.visited ? ` · abgerufen ${source.visited}` : ''}</span>
</a>