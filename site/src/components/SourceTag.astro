---
// Quelle als klickbarer Beleg-Tag + optionaler aufklappbarer Kontext (details, 0 JS).
interface Props {
  source: { label: string; url: string; visited?: string };
  tooltip?: string;
}
const { source, tooltip } = Astro.props;
---

<a class="source-tag" href={source.url} target="_blank" rel="noopener noreferrer">
  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
    <path d="M15 3h6v6" />
    <path d="M10 14 21 3" />
  </svg>
  <span>{source.label}{source.visited ? ` · abgerufen ${source.visited}` : ''}</span>
</a>
{
  tooltip && (
    <details class="ctx-tooltip">
      <summary>Einordnung</summary>
      <p>{tooltip}</p>
    </details>
  )
}

<style is:global>
  .ctx-tooltip {
    display: block;
    margin-top: 0.9rem;
    max-width: 52ch;
    font-size: 1rem;
    color: var(--fg);
  }
  .ctx-tooltip summary {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-head);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--accent);
    user-select: none;
    padding: 0.55rem 1rem;
    border: 1.5px solid var(--accent);
    border-radius: 99px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .ctx-tooltip summary::-webkit-details-marker { display: none; }
  .ctx-tooltip summary::after {
    content: '▾';
    font-size: 0.75em;
    transition: transform 0.15s ease;
  }
  .ctx-tooltip[open] summary::after { transform: rotate(180deg); }
  .ctx-tooltip[open] summary { background: color-mix(in srgb, var(--accent) 22%, transparent); }
  .ctx-tooltip p {
    margin-top: 0.7rem;
    line-height: 1.6;
    border-left: 2px solid var(--accent);
    padding-left: 0.85rem;
    color: var(--fg);
  }
</style>