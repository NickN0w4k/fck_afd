---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
import Hero from '../components/scenes/Hero.astro';
import Statement from '../components/scenes/Statement.astro';
import Data from '../components/scenes/Data.astro';
import Contrast from '../components/scenes/Contrast.astro';
import Quote from '../components/scenes/Quote.astro';
import Quiz from '../components/scenes/Quiz.astro';
import Slider from '../components/scenes/Slider.astro';
import Reveal from '../components/scenes/Reveal.astro';
import ChapterBreak from '../components/scenes/ChapterBreak.astro';
import Summary from '../components/scenes/Summary.astro';
import Sources from '../components/scenes/Sources.astro';
import EndCard from '../components/scenes/EndCard.astro';

import chaptersRaw from '../../../content/chapters.json';
import scenesRaw from '../../../content/scenes.json';
import { sceneShareText } from '../lib/scene-text.js';

const chapters = /** @type {any[]} */ (chaptersRaw);
const scenes = /** @type {any[]} */ ((/** @type {any} */ (scenesRaw)).scenes);
const chapterById = Object.fromEntries(chapters.map((c) => [c.id, c]));

const total = scenes.length;
---

<Base>
  <main class="feed" id="feed">
    {
      scenes.map((scene, i) => {
        const chapter = chapterById[scene.chapter];
        const accent = chapter?.accent;
        const shared = { index: i, total, accent, chapter: scene.chapter, shareText: sceneShareText(scene, chapter?.title) };
        switch (scene.type) {
          case 'hero':
            return (
              <Scene {...shared} id="scene-0">
                <Hero scene={scene} />
              </Scene>
            );
          case 'statement':
            return (
              <Scene {...shared}>
                <Statement scene={scene} />
              </Scene>
            );
          case 'data':
            return (
              <Scene {...shared}>
                <Data scene={scene} />
              </Scene>
            );
          case 'contrast':
            return (
              <Scene {...shared}>
                <Contrast scene={scene} />
              </Scene>
            );
          case 'quote':
            return (
              <Scene {...shared}>
                <Quote scene={scene} />
              </Scene>
            );
          case 'quiz':
            return (
              <Scene {...shared}>
                <Quiz scene={scene} />
              </Scene>
            );
          case 'slider':
            return (
              <Scene {...shared}>
                <Slider scene={scene} />
              </Scene>
            );
          case 'reveal':
            return (
              <Scene {...shared}>
                <Reveal scene={scene} />
              </Scene>
            );
          case 'chapterbreak':
            return (
              <Scene {...shared} kicker={`Kapitel ${chapter?.num ?? ''}`}>
                <ChapterBreak chapter={chapter} />
              </Scene>
            );
          case 'summary':
            return (
              <Scene {...shared}>
                <Summary scene={scene} chapters={chapters} />
              </Scene>
            );
          case 'sources':
            return (
              <Scene {...shared}>
                <Sources scene={scene} />
              </Scene>
            );
          case 'endcard':
            return (
              <Scene {...shared}>
                <EndCard scene={{ ...scene, accent }} />
              </Scene>
            );
          default:
            return null;
        }
      })
    }
  </main>

  <nav class="dots" aria-label="Kapitel-Navigation">
    {
      chapters.map((c) => (
        <button
          data-goto={`chapter-${c.id}`}
          aria-label={`Zu Kapitel ${c.num}: ${c.title}`}
          title={c.title}
          style={`--accent: ${c.accent}`}
        />
      ))
    }
  </nav>

  <script define:vars={{ scenesRaw }}>
    // TL;DR global für die ShareCard-Generierung (EndCard)
    const summary = (scenesRaw.scenes ?? scenesRaw).find((s) => s.type === 'summary');
    if (summary) window.__fckafd_tldr = summary.tldr;
    // 6 Kernfakten für die ShareCard (kurz, grafisch, eindrücklich)
    window.__fckafd_facts6 = [
      { big: '28.000', small: 'Menschen im AfD-Umfeld ordnet der Verfassungsschutz dem Rechtsextremismus zu.' },
      { big: '5×', small: 'Fünf Landesverbände gelten als gesichert rechtsextremistisch.' },
      { big: '+440 €', small: 'Eine 40.000-€-Familie verliert pro Jahr unter den AfD-Steuerplänen — Topverdiener gewinnen 19.190 €.' },
      { big: '690 Mrd. €', small: 'Kosten eines Dexit laut IW Köln — plus 2,5 Millionen Arbeitsplätze.' },
      { big: '2×', small: 'Björn Höcke wegen einer SA-Parole verurteilt — 13.000 € und 16.900 € (LG Halle).' },
      { big: '4 J. 9 M.', small: 'Haft für Krahs Mitarbeiter: Spionage für China aus dem EU-Büro des AfD-Spitzenkandidaten.' },
    ];
    // Kapitel-Dots: scrollt zur ersten Szene des jeweiligen Kapitels
    document.querySelectorAll('.dots button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const chapterId = btn.dataset.goto?.replace('chapter-', '');
        const target = document.querySelector(`.scene[data-chapter="${chapterId}"]`);
        target?.scrollIntoView({ behavior: 'smooth' });
      });
    });
  </script>
</Base>