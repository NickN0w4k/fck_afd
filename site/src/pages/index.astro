---
import Base from '../layouts/Base.astro';
import Scene from '../components/Scene.astro';
import SceneBody from '../components/SceneBody.astro';

import chaptersRaw from '../../../content/chapters.json';
import scenesRaw from '../../../content/scenes.json';
import { sceneShareText } from '../lib/scene-text.js';

const chapters = /** @type {any[]} */ (chaptersRaw);
const scenes = /** @type {any[]} */ ((/** @type {any} */ (scenesRaw)).scenes);
const chapterById = Object.fromEntries(chapters.map((c) => [c.id, c]));

const total = scenes.length;
---

<Base>
  <main class="feed" id="feed">
    {
      scenes.map((scene, i) => {
        const chapter = chapterById[scene.chapter];
        return (
          <Scene
            index={i}
            total={total}
            accent={chapter?.accent}
            chapter={scene.chapter}
            shareText={sceneShareText(scene, chapter?.title)}
            id={i === 0 ? 'scene-0' : undefined}
            kicker={scene.type === 'chapterbreak' ? `Kapitel ${chapter?.num ?? ''}` : undefined}
          >
            <SceneBody scene={scene} chapter={chapter} chapters={chapters} />
          </Scene>
        );
      })
    }
  </main>

  <nav class="dots" aria-label="Kapitel-Navigation">
    {
      chapters.map((c) => (
        <button
          data-goto={`chapter-${c.id}`}
          aria-label={`Zu Kapitel ${c.num}: ${c.title}`}
          title={c.title}
          style={`--accent: ${c.accent}`}
        />
      ))
    }
  </nav>

  <script define:vars={{ scenesRaw }}>
    // TL;DR global für die ShareCard-Generierung (EndCard)
    const summary = (scenesRaw.scenes ?? scenesRaw).find((s) => s.type === 'summary');
    if (summary) window.__fckafd_tldr = summary.tldr;
    // 6 Kernfakten für die ShareCard (kurz, grafisch, eindrücklich)
    window.__fckafd_facts6 = [
      { big: '28.000', small: 'Menschen im AfD-Umfeld ordnet der Verfassungsschutz dem Rechtsextremismus zu.' },
      { big: '5×', small: 'Fünf Landesverbände gelten als gesichert rechtsextremistisch.' },
      { big: '+440 €', small: 'Eine 40.000-€-Familie verliert pro Jahr unter den AfD-Steuerplänen — Topverdiener gewinnen 19.190 €.' },
      { big: '690 Mrd. €', small: 'Kosten eines Dexit laut IW Köln — plus 2,5 Millionen Arbeitsplätze.' },
      { big: '2×', small: 'Björn Höcke wegen einer SA-Parole verurteilt — 13.000 € und 16.900 € (LG Halle).' },
      { big: '4 J. 9 M.', small: 'Haft für Krahs Mitarbeiter: Spionage für China aus dem EU-Büro des AfD-Spitzenkandidaten.' },
    ];
    // Kapitel-Dots: scrollt zur ersten Szene des jeweiligen Kapitels
    document.querySelectorAll('.dots button').forEach((btn) => {
      btn.addEventListener('click', () => {
        const chapterId = btn.dataset.goto?.replace('chapter-', '');
        const target = document.querySelector(`.scene[data-chapter="${chapterId}"]`);
        target?.scrollIntoView({ behavior: 'smooth' });
      });
    });
  </script>
</Base>