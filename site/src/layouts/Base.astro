---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string; // Override: pro-Szene-OG (Welle 3) — sonst og-image.png
  ogImageAlt?: string;
}

const {
  title = 'Die AfD. Was du wissen solltest.',
  description = 'Die Fakten über die AfD. Jede mit Quelle.',
  ogImage: ogImageOverride,
  ogImageAlt: ogImageAltOverride,
} = Astro.props;

const site = Astro.site ?? new URL('https://info-afd.de/');
// Astro.url.pathname enthält base bereits (z.B. /fck_afd/quellen/); für og:image BASE_URL anhängen.
const canonical = new URL(Astro.url.pathname, site);
const base = import.meta.env.BASE_URL;
const ogImage = ogImageOverride ?? new URL(`${base.endsWith('/') ? base : `${base}/`}og-image.png`, site).toString();
const ogImageAlt = ogImageAltOverride ?? 'Die AfD. Die Fakten. — belegte Fakten mit Quelle, als scrollbare Tour.';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`}favicon.ico`} sizes="32x32" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Die AfD. Die Fakten." />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body>
    <div class="progress" aria-hidden="true"><div class="progress__bar"></div></div>
    <slot />
    <div class="grain" aria-hidden="true"></div>
    <script src="../scripts/animations.js"></script>
    <script src="../scripts/share.js"></script>
  </body>
</html>